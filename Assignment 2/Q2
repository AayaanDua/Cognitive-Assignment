scores = tuple(L[:8])
print("scores:", scores)

# (i)
high_score = max(scores)
print("Max score:", high_score, "at index:", scores.index(high_score))
low_score = min(scores)
print("Min score:", low_score, "count:", scores.count(low_score))

# (ii)
scores_rev = list(reversed(scores))
print("Reversed as list:", scores_rev)

# (iii)
user_score = int(input("Enter a score to search: "))
if user_score in scores:
    print("Found at index:", scores.index(user_score))
else:
    print("Score not present")

# (iv)
try:
    scores[0] = 95
except TypeError as e:
    print("Error:", e)

# (v)
first, second, *rest = scores
print("First:", first)
print("Second:", second)
