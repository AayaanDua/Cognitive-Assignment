scores = tuple(L[:8])
print("scores:", scores)

# (i)
top_score = max(scores)
print("Max score:", top_score, "at index:", scores.index(top_score))
low_score = min(scores)
print("Min score:", low_score, "count:", scores.count(low_score))

# (ii)
# Tuples cannot be reversed in place because their structure is immutable
scores_rev = list(reversed(scores))
print("Reversed as list:", scores_rev)

# (iii)
target = int(input("Enter a score to search: "))
if target in scores:
    print("Found at index:", scores.index(target))
else:
    print("Score not present")

# (iv)
try:
    scores[0] = 95
except TypeError as e:
    print("Error:", e)

# (v)
first, second, *rest = scores
print("First:", first)
print("Second:", second)
print("Rest:", rest)
