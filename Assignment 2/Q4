first_8_digits = [int(d) for d in "1024170284"[:8]]
A = {d * 7 for d in first_8_digits}
B = {d * 9 for d in first_8_digits}
print("Set A:", A)
print("Set B:", B)

# (vi)
print("Union:", A.union(B))

# (vii)
print("Intersection:", A.intersection(B))

# (viii)
print("A - B:", A.difference(B))
print("B - A:", B.difference(A))

# (ix)
print("Symmetric diff:", A.symmetric_difference(B))

# (x)
print("Is A subset of B:", A.issubset(B))
print("Is B superset of A:", B.issuperset(A))

# (xi)
val_to_drop = int(input("Enter value to discard: "))
A.discard(val_to_drop)
print("Set A after discard:", A)
