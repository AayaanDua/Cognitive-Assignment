import random

# (i)
random.seed(1024170284)
numbers = [random.randint(100, 900) for _ in range(100)]

# (ii)
odds = [n for n in numbers if n % 2 != 0]
print("Total odds:", len(odds))
print("Odd numbers:", odds)

# (iii)
evens = [n for n in numbers if n % 2 == 0]
print("Total evens:", len(evens))
print("Even numbers:", evens)


# (iv)
def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True


primes = [n for n in numbers if is_prime(n)]
print("Total primes:", len(primes))
print("Prime numbers:", primes)

# (v)
most_common = max(set(numbers), key=numbers.count)
print("Most frequent:", most_common, "Count:", numbers.count(most_common))
