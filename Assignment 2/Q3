import random

# Set random seed
seed_val = 102103456
random.seed(seed_val)

# (i)
numbers = [random.randint(100, 900) for _ in range(100)]

# (ii)
odd_list = [x for x in numbers if x % 2 != 0]
print("Total odds:", len(odd_list))
print("Odd values:", odd_list)

# (iii)
even_list = [x for x in numbers if x % 2 == 0]
print("Total evens:", len(even_list))
print("Even values:", even_list)

def check_prime(val):
    if val < 2:
        return False
    for i in range(2, int(val**0.5) + 1):
        if val % i == 0:
            return False
    return True


# (iv)
primes = [x for x in numbers if check_prime(x)]
print("Total primes:", len(primes))
print("Prime values:", primes)

# (v)
mode = max(set(numbers), key=numbers.count)
print("Most frequent:", mode, "Count:", numbers.count(mode))
