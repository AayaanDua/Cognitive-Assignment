roll_no = "1024170284"
L = [int(ch) * 10 for ch in roll_no]

# (i)
print("L:", L)

# (ii)
L.append(45)  
print("After append:", L)
L.insert(2, 88)  
print("After insert:", L)

# (iii)
L.remove(88)  
print("After remove:", L)
L.pop() 
print("After pop:", L)

# (iv)
L.sort()
print("Ascending:", L)
L.sort(reverse=True)
print("Descending:", L)

# (v)
print("First 3:", L[:3])
print("Last 3:", L[-3:])

# (vi)
avg_val = sum(L) / len(L)
above_avg = [x for x in L if x > avg_val]
print("Above average:", above_avg)
